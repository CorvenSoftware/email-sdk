import type { Redacted } from "effect";
import { smtpEmailLayer } from "@corvencore/email-sdk/smtp";

export const configuredSmtpAccount = (username: Redacted.Redacted, password: Redacted.Redacted) =>
  smtpEmailLayer({
    authentication: { _tag: "Plain", password, username },
    helloName: "app.example.test",
    host: "smtp.example.test",
    mailFlow: "ProviderUnmodified",
    port: 465,
    security: "ImplicitTls",
  });

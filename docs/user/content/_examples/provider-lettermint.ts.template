import { Layer } from "effect";
import type { Redacted } from "effect";
import { lettermintEmailLayer } from "@corven/email-sdk/lettermint";
import { emailHttpLayer } from "./sending.js";

export const configuredLettermintAccount = (apiToken: Redacted.Redacted) =>
  lettermintEmailLayer({ apiToken, route: "transactional" }).pipe(Layer.provide(emailHttpLayer));

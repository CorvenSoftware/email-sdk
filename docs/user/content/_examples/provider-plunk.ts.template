import { Layer } from "effect";
import type { Redacted } from "effect";
import { plunkEmailLayer } from "@corven/email-sdk/plunk";
import { emailHttpLayer } from "./sending.js";

export const configuredPlunkAccount = (apiKey: Redacted.Redacted) =>
  plunkEmailLayer({ apiKey, contactWrites: "AllowUpsert", tracking: "ProjectDisabled" }).pipe(
    Layer.provide(emailHttpLayer),
  );

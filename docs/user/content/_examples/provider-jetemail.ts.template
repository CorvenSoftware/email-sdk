import { Layer } from "effect";
import type { Redacted } from "effect";
import { jetemailEmailLayer } from "@corven/email-sdk/jetemail";
import { emailHttpLayer } from "./sending.js";

export const configuredJetemailAccount = (apiKey: Redacted.Redacted) =>
  jetemailEmailLayer({
    apiKey,
    automaticBcc: "DomainDisabled",
    tracking: "DomainDisabled",
    deliveryRegion: "ProviderSelected",
  }).pipe(Layer.provide(emailHttpLayer));

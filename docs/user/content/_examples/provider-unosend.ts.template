import { Layer } from "effect";
import type { Redacted } from "effect";
import { unosendEmailLayer } from "@corven/email-sdk/unosend";
import { emailHttpLayer } from "./sending.js";

export const configuredUnosendAccount = (apiKey: Redacted.Redacted) =>
  unosendEmailLayer({ apiKey }).pipe(Layer.provide(emailHttpLayer));

import { Layer } from "effect";
import { sesEmailLayer } from "@corvencore/email-sdk/ses";
import type { SesEmailOptions } from "@corvencore/email-sdk/ses";
import { emailHttpLayer } from "./sending.js";

export const configuredSesAccount = (
  credentials: Pick<SesEmailOptions, "accessKeyId" | "secretAccessKey" | "sessionToken">,
) =>
  sesEmailLayer({ ...credentials, mailFlow: "ProviderUnmodified", region: "us-east-1" }).pipe(
    Layer.provide(emailHttpLayer),
  );

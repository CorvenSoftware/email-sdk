import { Layer } from "effect";
import type { Redacted } from "effect";
import { mailersendEmailLayer } from "@corven/email-sdk/mailersend";
import { emailHttpLayer } from "./sending.js";

export const configuredMailersendAccount = (apiKey: Redacted.Redacted) =>
  mailersendEmailLayer({ apiKey }).pipe(Layer.provide(emailHttpLayer));

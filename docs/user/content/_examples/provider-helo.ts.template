import { Layer } from "effect";
import type { Redacted } from "effect";
import { heloEmailLayer } from "@corven/email-sdk/helo";
import { emailHttpLayer } from "./sending.js";

export const configuredHeloAccount = (apiKey: Redacted.Redacted) =>
  heloEmailLayer({ apiKey, channelMode: "Live" }).pipe(Layer.provide(emailHttpLayer));

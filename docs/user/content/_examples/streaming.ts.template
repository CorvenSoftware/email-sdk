import { Stream } from "effect";
import { sendEmailStream } from "@corvencore/email-sdk";

export const streamNotifications = sendEmailStream(
  Stream.fromIterable([
    {
      message: {
        body: { text: "Your fictional order is ready." },
        from: "sender@example.test",
        subject: "First order ready",
        to: "first@example.test",
      },
    },
    {
      message: {
        body: { text: "Your fictional order is ready." },
        from: "sender@example.test",
        subject: "Second order ready",
        to: "second@example.test",
      },
    },
  ]),
  { concurrency: 2 },
);

import { Layer } from "effect";
import type { Redacted } from "effect";
import { mailchimpEmailLayer } from "@corvencore/email-sdk/mailchimp";
import { emailHttpLayer } from "./sending.js";

export const configuredMailchimpAccount = (apiKey: Redacted.Redacted) =>
  mailchimpEmailLayer({
    apiKey,
    automaticFooter: "AccountDisabled",
    keyMode: "Live",
    messageRules: "AccountDisabled",
  }).pipe(Layer.provide(emailHttpLayer));

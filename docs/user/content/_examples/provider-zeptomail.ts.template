import { Layer } from "effect";
import type { Redacted } from "effect";
import { zeptomailEmailLayer } from "@corven/email-sdk/zeptomail";
import { emailHttpLayer } from "./sending.js";

export const configuredZeptomailAccount = (apiKey: Redacted.Redacted) =>
  zeptomailEmailLayer({ apiKey, agentMode: "Live" }).pipe(Layer.provide(emailHttpLayer));

import { Layer } from "effect";
import type { Redacted } from "effect";
import { sparkpostEmailLayer } from "@corven/email-sdk/sparkpost";
import { emailHttpLayer } from "./sending.js";

export const configuredSparkpostAccount = (apiKey: Redacted.Redacted) =>
  sparkpostEmailLayer({ apiKey, region: "UnitedStates" }).pipe(Layer.provide(emailHttpLayer));

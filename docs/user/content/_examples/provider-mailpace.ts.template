import { Layer } from "effect";
import type { Redacted } from "effect";
import { mailpaceEmailLayer } from "@corven/email-sdk/mailpace";
import { emailHttpLayer } from "./sending.js";

export const configuredMailpaceAccount = (serverToken: Redacted.Redacted) =>
  mailpaceEmailLayer({ serverToken }).pipe(Layer.provide(emailHttpLayer));

import { Layer } from "effect";
import type { Redacted } from "effect";
import { sendgridEmailLayer } from "@corven/email-sdk/sendgrid";
import { emailHttpLayer } from "./sending.js";

export const configuredSendgridAccount = (apiKey: Redacted.Redacted) =>
  sendgridEmailLayer({ apiKey, region: "Global" }).pipe(Layer.provide(emailHttpLayer));

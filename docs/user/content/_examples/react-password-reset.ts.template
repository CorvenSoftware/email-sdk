import { renderReactEmail } from "@corvencore/email-sdk/react";
import { transactionalEmailLayout } from "./react-layout.js";

export const passwordResetEmail = (input: { resetUrl: string; expiresIn: string }) =>
  renderReactEmail(
    transactionalEmailLayout({
      heading: "Reset your password",
      preview: "A password reset was requested for your account.",
      paragraphs: [
        `Use the link below within ${input.expiresIn}.`,
        "If you did not request a reset, you can ignore this message.",
      ],
      action: { href: input.resetUrl, label: "Reset password" },
    }),
  );

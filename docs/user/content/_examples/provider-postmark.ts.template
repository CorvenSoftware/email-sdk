import { Layer } from "effect";
import type { Redacted } from "effect";
import { postmarkEmailLayer } from "@corven/email-sdk/postmark";
import { emailHttpLayer } from "./sending.js";

export const configuredPostmarkAccount = (serverToken: Redacted.Redacted) =>
  postmarkEmailLayer({ serverToken, messageStream: "outbound" }).pipe(
    Layer.provide(emailHttpLayer),
  );

  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "check": "pnpm lint && pnpm typecheck && pnpm check:examples && pnpm docs:check",
    "lint": "oxlint --type-aware --deny-warnings && oxfmt --check",
    "fix": "oxfmt && oxlint --fix",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check:examples": "tsc --noEmit -p examples/tsconfig.json",
    "test": "vitest run",
    "build": "bash scripts/build.sh",
    "check:package": "bash scripts/check-package.sh",
    "changeset": "changeset",
    "release:status": "changeset status",
    "release:version": "changeset version && pnpm install --ignore-scripts",
    "docs:dev": "cd docs/user && ASTRO_TELEMETRY_DISABLED=1 blume dev",
    "docs:build": "cd docs/user && ASTRO_TELEMETRY_DISABLED=1 blume build",
    "docs:deploy": "ALCHEMY_TELEMETRY_DISABLED=1 alchemy deploy --stage prod",
    "docs:check": "cd docs/user && blume doctor && blume validate --strict",
    "docs:preview": "cd docs/user && ASTRO_TELEMETRY_DISABLED=1 blume preview",
    "prepare": "effect-tsgo patch"
  },
  "devDependencies": {

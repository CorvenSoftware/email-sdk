import EffectLibrary = require("effect");
import EffectHttp = require("effect/http");
import EmailSdk = require("@corvencore/email-sdk");
import ProviderKit = require("@corvencore/email-sdk/provider");
import Brevo = require("@corvencore/email-sdk/brevo");
import Sequenzy = require("@corvencore/email-sdk/sequenzy");
import Sendheron = require("@corvencore/email-sdk/sendheron");
import Iterable = require("@corvencore/email-sdk/iterable");
import IterableDefaults = require("@corvencore/email-sdk/iterable-defaults");
import NativeObservations = require("@corvencore/email-sdk/native-observations");
import NativeCapture = require("@corvencore/email-sdk/native-capture");
import Loops = require("@corvencore/email-sdk/loops");
import ProviderScenarios = require("./provider-scenarios.js");

const { Effect, Redacted } = EffectLibrary;
const { EmailRejected } = EmailSdk;
const apiKey = Redacted.make("fictional-unused-key");
const brevo: EffectLibrary.Layer.Layer<EmailSdk.Email, EmailSdk.EmailConfigurationError, EffectHttp.HttpClient.HttpClient> = Brevo.brevoEmailLayer({ apiKey, contentAuthority: "AuthorizeProviderRendering", submissionMode: "TransactionalOnly", tracking: "AuthorizeProviderTracking" });
const sequenzy: EffectLibrary.Layer.Layer<EmailSdk.Email, EmailSdk.EmailConfigurationError, EffectHttp.HttpClient.HttpClient> = Sequenzy.sequenzyEmailLayer({ apiKey, automaticUtm: "AccountDisabled", contactWrites: "AuthorizeProviderManagedProfiles", contentAuthority: "AuthorizeProviderRenderingAndRetention", replyTracking: "AccountDisabled", senderIdentity: "ExistingVerifiedProfile", submissionMode: "TransactionalOnly" });
const sendheron: EffectLibrary.Layer.Layer<EmailSdk.Email, EmailSdk.EmailConfigurationError, EffectHttp.HttpClient.HttpClient> = Sendheron.sendheronEmailLayer({ apiKey, submissionMode: "TransactionalOnly", tracking: "AuthorizeProviderTracking" });
const iterable: EffectLibrary.Layer.Layer<Iterable.IterableCampaignEmail, EmailSdk.EmailConfigurationError, EffectHttp.HttpClient.HttpClient> = Iterable.iterableCampaignLayer({ apiKey, campaignAuthority: "AuthorizeProviderManagedCampaign", contactWrites: "AuthorizeProfileCreation", dataRetention: "AuthorizePersistedSendData", projectIdentity: "EmailBased", region: "US", tracking: "AuthorizeCampaignTracking" });
const proveNativeCapture = <E, R>(loops: EffectLibrary.Layer.Layer<Loops.LoopsTransactionalEmail, E, R>, account: EffectLibrary.Layer.Layer<Iterable.IterableCampaignEmail, E, R>): EffectLibrary.Layer.Layer<Iterable.IterableCampaignEmail | NativeCapture.EmailNativeCapture, E | EmailSdk.EmailConfigurationError, R> => {
  const options = { capacity: 1, maxBytes: 10000, privateData: "AuthorizePayloadCapture" } as const;
  const captured: EffectLibrary.Layer.Layer<Loops.LoopsTransactionalEmail | NativeCapture.EmailNativeCapture, E | EmailSdk.EmailConfigurationError, R> = NativeCapture.capturedLoopsTransactionalLayer(loops, options);
  // @ts-expect-error -- Native capture requires explicit trusted-host permission and bounds.
  void NativeCapture.capturedLoopsTransactionalLayer(loops);
  // @ts-expect-error -- Native capture cannot decorate ordinary Email.
  void NativeCapture.capturedIterableCampaignLayer(brevo, options);
  void captured;
  return NativeCapture.capturedIterableCampaignLayer(account, options);
};
void proveNativeCapture;
const proveNativeObservations = <E, R>(loops: EffectLibrary.Layer.Layer<Loops.LoopsTransactionalEmail, E, R>, account: EffectLibrary.Layer.Layer<Iterable.IterableCampaignEmail, E, R>, observer: NativeObservations.EmailNativeObserver, starting: NativeObservations.EmailNativeOperationStarting, startingObserver: NativeObservations.EmailNativeStartingObserver): EffectLibrary.Layer.Layer<Iterable.IterableCampaignEmail | NativeObservations.EmailNativeObservations, E | EmailSdk.EmailConfigurationError, R> => {
  const requiringObserver = () => Effect.asVoid(EmailSdk.Email);
  const refusesContext: typeof requiringObserver extends NativeObservations.EmailNativeStartingObserver ? false : true = true;
  const refusesSettled: NativeObservations.EmailNativeObserver extends NativeObservations.EmailNativeStartingObserver ? false : true = true;
  // @ts-expect-error -- Native starting facts cannot change the selected operation.
  starting.operation = "IterableCampaign";
  // @ts-expect-error -- Native starting facts do not contain jobs.
  void starting.job;
  // @ts-expect-error -- Native starting callbacks are not serialized options.
  void NativeObservations.observedIterableCampaignLayer(account, { onStarting: startingObserver });
  void refusesContext;
  void refusesSettled;
  const observed: EffectLibrary.Layer.Layer<Loops.LoopsTransactionalEmail | NativeObservations.EmailNativeObservations, E | EmailSdk.EmailConfigurationError, R> = NativeObservations.observedLoopsTransactionalLayer(loops, {}, observer, startingObserver);
  // @ts-expect-error -- Ordinary Email does not implement a native operation boundary.
  void NativeObservations.observedIterableCampaignLayer(brevo);
  // @ts-expect-error -- Callback code is not a serialized native observation option.
  void NativeObservations.observedIterableCampaignLayer(account, { onReceipt: "callback" });
  const failingObserver = () => Effect.fail(new EmailRejected({ provider: "fixture", reason: "rejected" }));
  const refusesStartingErrors: typeof failingObserver extends NativeObservations.EmailNativeStartingObserver ? false : true = true;
  void refusesStartingErrors;
  // @ts-expect-error -- Callback failure cannot become a retryable native outcome.
  void NativeObservations.observedIterableCampaignLayer(account, {}, failingObserver);
  void observed;
  return NativeObservations.observedIterableCampaignLayer(account, {}, observer, startingObserver);
};
void proveNativeObservations;
const proveIterableDefaults = <E, R>(account: EffectLibrary.Layer.Layer<Iterable.IterableCampaignEmail, E, R>, defaults: IterableDefaults.IterableCampaignDefaultsInput): EffectLibrary.Layer.Layer<Iterable.IterableCampaignEmail, E | EmailSdk.EmailConfigurationError, R> => {
  // @ts-expect-error -- CommonJS native defaults cannot select campaigns.
  void IterableDefaults.defaultedIterableCampaignLayer(account, { campaignId: 123 });
  // @ts-expect-error -- Native data cannot contain nested object defaults.
  void IterableDefaults.defaultedIterableCampaignLayer(account, { dataFields: { nested: { value: 0 } } });
  // @ts-expect-error -- Ordinary Email cannot acquire native campaign authority.
  void IterableDefaults.defaultedIterableCampaignLayer(brevo, {});
  return IterableDefaults.defaultedIterableCampaignLayer(account, defaults);
};
void proveIterableDefaults;
const proveProviderTypes = (native: Iterable.IIterableCampaignEmail, preview: Iterable.IterableCampaignJob): void => {
  // @ts-expect-error -- CommonJS native campaigns do not accept common sender overrides.
  void native.send({ campaignId: 123, recipientEmail: "recipient@fictional.invalid", from: "host@fictional.invalid" });
  // @ts-expect-error -- CommonJS owned campaign identities remain readonly.
  preview.campaignId = 456;
  // @ts-expect-error -- Open tracking cannot be represented as a provider opt-out.
  void Sendheron.sendheronEmailLayer({ apiKey, submissionMode: "TransactionalOnly", tracking: "Disabled" });
  // @ts-expect-error -- Brevo requires explicit rendering/tracking authority.
  void Brevo.brevoEmailLayer({ apiKey });
};
void proveProviderTypes;

void Effect.runPromise(ProviderScenarios.verifyInstalledProviders({ ProviderKit, EffectLibrary, EffectHttp, EmailSdk, Brevo, Sequenzy, Sendheron, Iterable, IterableDefaults, NativeObservations, NativeCapture }));

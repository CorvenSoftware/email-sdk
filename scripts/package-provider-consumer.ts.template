import * as ProviderKit from "@corvencore/email-sdk/provider";
import * as EffectLibrary from "effect";
import * as EffectHttp from "effect/http";
import * as EmailSdk from "@corvencore/email-sdk";
import * as Brevo from "@corvencore/email-sdk/brevo";
import * as Sequenzy from "@corvencore/email-sdk/sequenzy";
import * as Sendheron from "@corvencore/email-sdk/sendheron";
import * as Iterable from "@corvencore/email-sdk/iterable";
import * as IterableDefaults from "@corvencore/email-sdk/iterable-defaults";
import * as NativeObservations from "@corvencore/email-sdk/native-observations";
import * as NativeCapture from "@corvencore/email-sdk/native-capture";
import { verifyInstalledProviders } from "./provider-scenarios.js";
import { Effect, Layer, Redacted } from "effect";
import { HttpClient } from "effect/http";
import { Email, EmailRejected } from "@corvencore/email-sdk";
import type { EmailConfigurationError } from "@corvencore/email-sdk";
import { brevoEmailLayer } from "@corvencore/email-sdk/brevo";
import { sequenzyEmailLayer } from "@corvencore/email-sdk/sequenzy";
import { sendheronEmailLayer } from "@corvencore/email-sdk/sendheron";
import { IterableCampaignEmail, iterableCampaignLayer } from "@corvencore/email-sdk/iterable";
import type { IIterableCampaignEmail, IterableCampaignJob } from "@corvencore/email-sdk/iterable";
import { defaultedIterableCampaignLayer } from "@corvencore/email-sdk/iterable-defaults";
import type { IterableCampaignDefaultsInput } from "@corvencore/email-sdk/iterable-defaults";
import { EmailNativeObservations, observedIterableCampaignLayer, observedLoopsTransactionalLayer } from "@corvencore/email-sdk/native-observations";
import type { EmailNativeObserver, EmailNativeOperationStarting, EmailNativeStartingObserver } from "@corvencore/email-sdk/native-observations";
import type { LoopsTransactionalEmail } from "@corvencore/email-sdk/loops";
import { EmailNativeCapture, capturedLoopsTransactionalLayer, capturedIterableCampaignLayer } from "@corvencore/email-sdk/native-capture";

const apiKey = Redacted.make("fictional-unused-key");
const brevo: Layer.Layer<Email, EmailConfigurationError, HttpClient.HttpClient> = brevoEmailLayer({ apiKey, contentAuthority: "AuthorizeProviderRendering", submissionMode: "TransactionalOnly", tracking: "AuthorizeProviderTracking" });
const sequenzy: Layer.Layer<Email, EmailConfigurationError, HttpClient.HttpClient> = sequenzyEmailLayer({ apiKey, automaticUtm: "AccountDisabled", contactWrites: "AuthorizeProviderManagedProfiles", contentAuthority: "AuthorizeProviderRenderingAndRetention", replyTracking: "AccountDisabled", senderIdentity: "ExistingVerifiedProfile", submissionMode: "TransactionalOnly" });
const sendheron: Layer.Layer<Email, EmailConfigurationError, HttpClient.HttpClient> = sendheronEmailLayer({ apiKey, submissionMode: "TransactionalOnly", tracking: "AuthorizeProviderTracking" });
const iterable: Layer.Layer<IterableCampaignEmail, EmailConfigurationError, HttpClient.HttpClient> = iterableCampaignLayer({ apiKey, campaignAuthority: "AuthorizeProviderManagedCampaign", contactWrites: "AuthorizeProfileCreation", dataRetention: "AuthorizePersistedSendData", projectIdentity: "EmailBased", region: "US", tracking: "AuthorizeCampaignTracking" });

const proveNativeCapture = <E, R>(loops: Layer.Layer<LoopsTransactionalEmail, E, R>, account: Layer.Layer<IterableCampaignEmail, E, R>): Layer.Layer<IterableCampaignEmail | EmailNativeCapture, E | EmailConfigurationError, R> => {
  const options = { capacity: 1, maxBytes: 10000, privateData: "AuthorizePayloadCapture" } as const;
  const captured: Layer.Layer<LoopsTransactionalEmail | EmailNativeCapture, E | EmailConfigurationError, R> = capturedLoopsTransactionalLayer(loops, options);
  // @ts-expect-error -- Native capture requires explicit host permission and bounds.
  void capturedLoopsTransactionalLayer(loops);
  // @ts-expect-error -- Native capture cannot decorate ordinary Email authority.
  void capturedIterableCampaignLayer(brevo, options);
  void captured;
  return capturedIterableCampaignLayer(account, options);
};
void proveNativeCapture;
const proveNativeObservations = <E, R>(loops: Layer.Layer<LoopsTransactionalEmail, E, R>, account: Layer.Layer<IterableCampaignEmail, E, R>, observer: EmailNativeObserver, starting: EmailNativeOperationStarting, startingObserver: EmailNativeStartingObserver): Layer.Layer<IterableCampaignEmail | EmailNativeObservations, E | EmailConfigurationError, R> => {
  const requiringObserver = () => Effect.asVoid(Email);
  const refusesContext: typeof requiringObserver extends EmailNativeStartingObserver ? false : true = true;
  const refusesSettled: EmailNativeObserver extends EmailNativeStartingObserver ? false : true = true;
  // @ts-expect-error -- Native starting facts cannot change the selected operation.
  starting.operation = "IterableCampaign";
  // @ts-expect-error -- Native starting facts do not contain jobs.
  void starting.job;
  // @ts-expect-error -- Native starting callbacks are not serialized options.
  void observedIterableCampaignLayer(account, { onStarting: startingObserver });
  void refusesContext;
  void refusesSettled;
  const observed: Layer.Layer<LoopsTransactionalEmail | EmailNativeObservations, E | EmailConfigurationError, R> = observedLoopsTransactionalLayer(loops, {}, observer, startingObserver);
  // @ts-expect-error -- An ordinary Email Layer is not a native operation boundary.
  void observedIterableCampaignLayer(brevo);
  // @ts-expect-error -- Callback code is not serialized observation configuration.
  void observedIterableCampaignLayer(account, { onReceipt: "callback" });
  const failingObserver = () => Effect.fail(new EmailRejected({ provider: "fixture", reason: "rejected" }));
  const refusesStartingErrors: typeof failingObserver extends EmailNativeStartingObserver ? false : true = true;
  void refusesStartingErrors;
  // @ts-expect-error -- Callback failure cannot become a retryable native outcome.
  void observedIterableCampaignLayer(account, {}, failingObserver);
  void observed;
  return observedIterableCampaignLayer(account, {}, observer, startingObserver);
};
void proveNativeObservations;

const proveIterableDefaults = <E, R>(account: Layer.Layer<IterableCampaignEmail, E, R>, defaults: IterableCampaignDefaultsInput): Layer.Layer<IterableCampaignEmail, E | EmailConfigurationError, R> => {
  // @ts-expect-error -- Native defaults do not select campaigns or supply key authority.
  void defaultedIterableCampaignLayer(account, { campaignId: 123 });
  // @ts-expect-error -- Native data cannot contain nested object defaults.
  void defaultedIterableCampaignLayer(account, { dataFields: { nested: { value: 0 } } });
  // @ts-expect-error -- Ordinary Email is not the native campaign capability.
  void defaultedIterableCampaignLayer(brevo, {});
  return defaultedIterableCampaignLayer(account, defaults);
};
void proveIterableDefaults;

const proveProviderTypes = (native: IIterableCampaignEmail, preview: IterableCampaignJob): void => {
  // @ts-expect-error -- A native campaign does not accept common sender/content overrides.
  void native.send({ campaignId: 123, recipientEmail: "recipient@fictional.invalid", from: "host@fictional.invalid" });
  // @ts-expect-error -- Owned native campaign identity remains readonly.
  preview.campaignId = 456;
  // @ts-expect-error -- Required open tracking authorization is not a remote opt-out.
  void sendheronEmailLayer({ apiKey, submissionMode: "TransactionalOnly", tracking: "Disabled" });
  // @ts-expect-error -- Brevo cannot silently acquire rendering/tracking authority.
  void brevoEmailLayer({ apiKey });
};
void proveProviderTypes;

const provePrivateDeclarations = (): void => {
  // @ts-expect-error -- Native orchestration is private to the installed package.
  void import("@corvencore/email-sdk/email-native-operations");
  // @ts-expect-error -- Capture retention is private value logic, not a reset service.
  void import("@corvencore/email-sdk/dist/email-capture-retention.js");
  // @ts-expect-error -- Outcome encoding does not grant a public capture/replay capability.
  void import("@corvencore/email-sdk/dist/email-capture-outcome.js");
  // @ts-expect-error -- Observation retention is private implementation, not another service.
  void import("@corvencore/email-sdk/dist/email-observation-retention.js");
  // @ts-expect-error -- Compound failure protection is not a public entrypoint.
  void import("@corvencore/email-sdk/dist/email-unsettled-cause.js");
  // @ts-expect-error -- Canonical native job ownership remains private.
  void import("@corvencore/email-sdk/dist/iterable-campaign-job.js");
  // @ts-expect-error -- Public authoring does not expose internal transport orchestration.
  void import("@corvencore/email-sdk/dist/email-http-protocol.js");
};
void provePrivateDeclarations;

await Effect.runPromise(verifyInstalledProviders({ ProviderKit, EffectLibrary, EffectHttp, EmailSdk, Brevo, Sequenzy, Sendheron, Iterable, IterableDefaults, NativeObservations, NativeCapture }));

import assert from "node:assert/strict";

const forbiddenPackageSpecifiers = [
  "@corvencore/email-sdk/src/email-service.js",
  "@corvencore/email-sdk/email-native-operations",
  "@corvencore/email-sdk/dist/email-cli-main.js",
  "@corvencore/email-sdk/dist/email-cli.js",
  "@corvencore/email-sdk/dist/email-cli-node.js",
  "@corvencore/email-sdk/dist/email-bounded-json.js",
  "@corvencore/email-sdk/dist/loops-transactional-job.js",
  "@corvencore/email-sdk/dist/email-retry-decision.js",
  "@corvencore/email-sdk/dist/email-capture-aggregate.js",
  "@corvencore/email-sdk/dist/email-submission-capture-view.js",
  "@corvencore/email-sdk/dist/email-operation-observations.js",
  "@corvencore/email-sdk/dist/email-observation-aggregate.js",
  "@corvencore/email-sdk/dist/email-observation-aggregate-error.js",
  "@corvencore/email-sdk/dist/email-submission-observation-view.js",
  "@corvencore/email-sdk/dist/email-aggregate-sources.js",
  "@corvencore/email-sdk/dist/email-execution-metadata.js",
  "@corvencore/email-sdk/dist/email-preflight.js",
  "@corvencore/email-sdk/dist/email-routing-diagnostics.js",
  "@corvencore/email-sdk/dist/email-stream.js",

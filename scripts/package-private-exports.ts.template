  "@corvencore/email-sdk/dist/email-capture-outcome.js",
  "@corvencore/email-sdk/dist/email-observation-retention.js",
  "@corvencore/email-sdk/dist/email-unsettled-cause.js",
  "@corvencore/email-sdk/dist/iterable-campaign-job.js",
  "@corvencore/email-sdk/dist/email-http-protocol.js",
  "@corvencore/email-sdk/dist/email-http-execution.js",
  "@corvencore/email-sdk/dist/email-capture-store.js",

  "@corvencore/email-sdk/dist/email-react-components.js",
  "@corvencore/email-sdk/dist/email-react-theme.js",
] as const;

export const verifyPrivatePackageExports = async (load: (specifier: string) => unknown): Promise<void> => {
  for (const specifier of forbiddenPackageSpecifiers) {
    await assert.rejects(async () => load(specifier), { code: "ERR_PACKAGE_PATH_NOT_EXPORTED" });
  }
};

import * as EffectLibrary from "effect";
import * as Agent from "@corvencore/email-sdk/agent";
import * as Ai from "@corvencore/email-sdk/ai";
import * as Testing from "@corvencore/email-sdk/testing";
import { verifyInstalledAiTool } from "./ai-scenarios.js";
import { Effect } from "effect";
import type { Scope } from "effect";
import { EmailAgent } from "@corvencore/email-sdk/agent";
import type { EmailAgentInput } from "@corvencore/email-sdk/agent";
import { emailAiTool } from "@corvencore/email-sdk/ai";
import type { EmailAiReceipt, EmailAiRunner, EmailAiTool } from "@corvencore/email-sdk/ai";

const proveAiDeclarations = (run: EmailAiRunner, tool: EmailAiTool, receipt: EmailAiReceipt): void => {
  const acquired: Effect.Effect<EmailAiTool, never, EmailAgent | Scope.Scope> = emailAiTool(run);
  const tools = { sendEmail: tool };
  const input: EmailAgentInput = { body: { text: "Fictional" }, subject: "Fictional", to: "recipient@example.test" };
  const ordinary: EmailAgentInput = input;
  // @ts-expect-error -- Model output never includes private provider IDs.
  void receipt.messageId;
  // @ts-expect-error -- Model input never carries host approval.
  void tools.sendEmail.execute({ ...ordinary, approved: true }, { context: undefined, messages: [], toolCallId: "fictional" });
  void acquired;
};
void proveAiDeclarations;

await Effect.runPromise(verifyInstalledAiTool({ EffectLibrary, Agent, Ai, Testing }));

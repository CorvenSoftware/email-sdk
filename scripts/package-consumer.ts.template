const proveAgentDeclarations = (agent: IEmailAgent, input: EmailAgentInput, proposal: EmailAgentProposal): void => {
  const layer: Layer.Layer<EmailAgent, EmailConfigurationError, Email | EmailAgentApproval> = emailAgentLayer({ from: "host@fictional.invalid" });
  // @ts-expect-error -- Model input cannot replace the host sender.
  void agent.submit({ ...input, from: "model@fictional.invalid" });
  // @ts-expect-error -- Model input cannot approve or identify a submission.
  void agent.submit({ ...input, approved: true, idempotencyKey: "model-key" });
  // @ts-expect-error -- Approval proposals retain readonly ownership.
  proposal.message.subject = "changed";
  // @ts-expect-error -- Host decisions are explicit, not booleans.
  void EmailAgentApproval.of({ review: () => Effect.succeed(true) });
  const pending = EmailAgent.pipe(Effect.flatMap((agent) => agent.submit(input)), Effect.provide(emailAgentLayer({ from: "host@fictional.invalid" }).pipe(Layer.provide(recordingEmailLayer))));
  // @ts-expect-error -- Without host approval the operation is not runnable.
  const runnable: Effect.Effect<EmailReceipt, EmailSendError | EmailAgentApprovalError | EmailConfigurationError> = pending;
  void runnable;
  void layer;
};
void proveAgentDeclarations;


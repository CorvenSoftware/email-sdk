const proveRetryDeclarations = (decision: EmailRetryDecision, observer: EmailRetryObserver, restriction: EmailRetryRestriction, candidate: EmailRetryCandidate): void => {
  const requiringRestriction = () => Effect.as(Email, true);
  const synchronousRestriction = () => true;
  const refusesRestrictionContext: typeof requiringRestriction extends EmailRetryRestriction ? false : true = true;
  const refusesSynchronousRestriction: typeof synchronousRestriction extends EmailRetryRestriction ? false : true = true;
  const refusesVoidRestriction: EmailRetryObserver extends EmailRetryRestriction ? false : true = true;
  const refusesObserverSubstitution: EmailRetryRestriction extends EmailRetryObserver ? false : true = true;
  void refusesObserverSubstitution;
  // @ts-expect-error -- Retry restrictions are explicit host Effects, not policy JSON.
  void emailLayer({ maxAttempts: 2, initialDelay: Duration.millis(1), deadline: Duration.seconds(30), shouldRetry: restriction });
  void refusesRestrictionContext; void refusesSynchronousRestriction; void refusesVoidRestriction;
  const layer: Layer.Layer<Email, EmailConfigurationError, HttpClient.HttpClient> = resendEmailLayer({ apiKey: Redacted.make("fictional-key") }, undefined, observer, restriction);
  const failingObserver = () => Effect.fail(new EmailRejected({ provider: "fixture", reason: "rejected" }));
  const requiringObserver = () => Effect.asVoid(Email);
  const refusesRestrictionErrors: typeof failingObserver extends EmailRetryRestriction ? false : true = true;
  void refusesRestrictionErrors;
  const refusesErrors: typeof failingObserver extends EmailRetryObserver ? false : true = true;
  const refusesContext: typeof requiringObserver extends EmailRetryObserver ? false : true = true;
  // @ts-expect-error -- Candidate ordinals cannot change scheduled SDK attempts.
  candidate.nextAttempt = 2;
  // @ts-expect-error -- Restriction candidates do not expose private request payloads.
  void candidate.message;
  // @ts-expect-error -- Retry facts do not expose private request payloads.
  void decision.message;
  // @ts-expect-error -- Retry facts cannot change operation-local numbering.
  decision.nextAttempt = 2;
  // @ts-expect-error -- Callback code is not serialized policy authority.
  void emailLayer({ maxAttempts: 2, initialDelay: Duration.millis(1), deadline: Duration.seconds(30), onRetry: observer });
  void layer; void refusesErrors; void refusesContext;
};
void proveRetryDeclarations;

const proveObservationDeclarations = (view: IEmailSubmissionObservations, snapshot: EmailSubmissionObservationSnapshot, starting: EmailSubmissionStarting, startingObserver: EmailSubmissionStartingObserver): void => {
  const layer: Layer.Layer<EmailSender | EmailSubmissionObservations, EmailConfigurationError> = observedEmailSenderLayer(recordingSenderLayer, {}, undefined, startingObserver);
  const requiringObserver = () => Effect.asVoid(Email);
  const refusesContext: typeof requiringObserver extends EmailSubmissionStartingObserver ? false : true = true;
  const refusesSettled: EmailSubmissionObserver extends EmailSubmissionStartingObserver ? false : true = true;
  // @ts-expect-error -- Starting facts cannot replace acquired sender identity.
  starting.provider = "replacement";
  // @ts-expect-error -- Starting callbacks never expose message intent.
  void starting.message;
  // @ts-expect-error -- Starting callbacks are explicit host code, not serialized options.
  void observedEmailSenderLayer(recordingSenderLayer, { onStarting: startingObserver });
  void layer;
  void refusesContext;
  void refusesSettled;
  const effect: Effect.Effect<EmailSubmissionObservationSnapshot> = view.snapshot;
  // @ts-expect-error -- Observation options never accept application callbacks.
  void observedEmailSenderLayer(recordingSenderLayer, { onReceipt: () => undefined });
  const failingObserver = () => Effect.fail(new EmailRejected({ provider: "fixture", reason: "rejected" }));
  const refusesStartingErrors: typeof failingObserver extends EmailSubmissionStartingObserver ? false : true = true;
  void refusesStartingErrors;
  // @ts-expect-error -- Callback failures cannot grant submission retry authority.
  void observedEmailSenderLayer(recordingSenderLayer, {}, failingObserver);
  // @ts-expect-error -- Bounded snapshot state cannot be reset by callers.
  snapshot.observations.length = 0;
  // @ts-expect-error -- Explicit observations do not consume unrelated Layers.
  void observedEmailSenderLayer(Layer.empty);
  void effect;
};
void proveObservationDeclarations;


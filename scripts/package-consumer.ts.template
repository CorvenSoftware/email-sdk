  const refusesSynchronousRestriction: typeof synchronousRestriction extends EmailRetryRestriction ? false : true = true;
  const refusesVoidRestriction: EmailRetryObserver extends EmailRetryRestriction ? false : true = true;
  const refusesObserverSubstitution: EmailRetryRestriction extends EmailRetryObserver ? false : true = true;
  void refusesObserverSubstitution;
  // @ts-expect-error -- Retry restrictions are explicit host Effects, not policy JSON.
  void emailLayer({ maxAttempts: 2, initialDelay: Duration.millis(1), deadline: Duration.seconds(30), shouldRetry: restriction });

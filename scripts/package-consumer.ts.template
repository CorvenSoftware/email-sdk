  const layer: Layer.Layer<Email, EmailConfigurationError, HttpClient.HttpClient> = resendEmailLayer({ apiKey: Redacted.make("fictional-key") }, undefined, observer, restriction);
  const failingObserver = () => Effect.fail(new EmailRejected({ provider: "fixture", reason: "rejected" }));
  const requiringObserver = () => Effect.asVoid(Email);
  const refusesRestrictionErrors: typeof failingObserver extends EmailRetryRestriction ? false : true = true;
  void refusesRestrictionErrors;
  const refusesErrors: typeof failingObserver extends EmailRetryObserver ? false : true = true;
  const refusesContext: typeof requiringObserver extends EmailRetryObserver ? false : true = true;
  // @ts-expect-error -- Candidate ordinals cannot change scheduled SDK attempts.
  candidate.nextAttempt = 2;
  // @ts-expect-error -- Restriction candidates do not expose private request payloads.
  void candidate.message;

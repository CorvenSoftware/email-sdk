const mailgunWebhookSecret = "fictional-packed-mailgun-signing-key";
const proveMailgunWebhookDeclarations = (verifier: IMailgunWebhookVerifier, proof: VerifiedMailgunWebhookSignature, event: MailgunWebhookEvent): void => {
  const parsed: Effect.Effect<MailgunWebhookEvent, EmailWebhookNormalizationError> = parseMailgunWebhookEvent("raw JSON");
  const provenance: "UnverifiedPayload" = event.provenance;
  // @ts-expect-error -- Challenge proof never becomes event-body data.
  void parseMailgunWebhookEvent(proof);
  // @ts-expect-error -- Unsigned events do not authenticate Resend bodies.
  void parseResendWebhookEvent(event);
  // @ts-expect-error -- Provider-day event IDs are not synthetic delivery identities.
  void event.deliveryId;
  // @ts-expect-error -- RFC header values are not reconstructed submission handles.
  void event.providerMessageId;
  void parsed;
  void provenance;
  const verified: Effect.Effect<VerifiedMailgunWebhookSignature, EmailWebhookVerificationError> = verifier.verifySignature({ timestamp: 1_791_849_600, token: "fictional-token", signature: "00".repeat(32) });
  void verified;
  // @ts-expect-error -- Mailgun signing credentials remain Redacted.
  void mailgunWebhookLayer({ signingSecrets: ["unwrapped-key"], signatureField: "signature" });
  // @ts-expect-error -- Mailgun primary/parent selection is explicit.
  void mailgunWebhookLayer({ signingSecrets: [Redacted.make(mailgunWebhookSecret)] });
  // @ts-expect-error -- Mailgun challenge proof never authenticates an event body.
  const payload: VerifiedResendWebhook = proof;
  // @ts-expect-error -- Mailgun challenge proof cannot enter an authenticated-body parser.
  void parseResendWebhookEvent(proof);
  // @ts-expect-error -- Raw event bodies are not inputs to Mailgun signature verification.
  void verifier.verifySignature({ body: "raw event", headers: [] });
  void payload;
};
void proveMailgunWebhookDeclarations;

const proveWebhookDeclarations = (verifier: IResendWebhookVerifier, proof: VerifiedResendWebhook): void => {
  const verified: Effect.Effect<VerifiedResendWebhook, EmailWebhookVerificationError> = verifier.verify({ body: "raw", headers: [] });
  void verified;
  const parsed: Effect.Effect<ResendWebhookEvent, EmailWebhookNormalizationError> = parseResendWebhookEvent(proof);
  void parsed;
  // @ts-expect-error -- Normalization requires nominal authenticated proof, not raw fields.
  void parseResendWebhookEvent({ body: proof.body, id: proof.id, timestamp: proof.timestamp });
  // @ts-expect-error -- Signing credentials remain Redacted.
  void resendWebhookLayer({ signingSecrets: ["unwrapped-secret"] });
  // @ts-expect-error -- Merged dictionaries cannot preserve duplicate signing headers.
  void verifier.verify({ body: "raw", headers: { "svix-id": "opaque" } });
  // @ts-expect-error -- Unverified fields cannot manufacture verification proof.
  const forged: VerifiedResendWebhook = { body: proof.body, id: proof.id, timestamp: proof.timestamp };
  void forged;
};
void proveWebhookDeclarations;


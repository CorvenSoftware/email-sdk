await Effect.runPromise(
  Effect.gen(function* verifyInstalledNativeBatch() {
    const requests = yield* Ref.make(0);
    const transport = Layer.succeed(
      HttpClient.HttpClient,
      HttpClient.make((request) =>
        Effect.gen(function* acknowledgeSyntheticBatch() {
          yield* Ref.update(requests, (count) => count + 1);
          assert.equal(request.url, "https://api.resend.com/emails/batch");
          assert.equal(request.headers["x-batch-validation"], "strict");
          assert.equal(request.headers["idempotency-key"], "installed/batch-1");
          return HttpClientResponse.fromWeb(
            request,
            new Response(JSON.stringify({ data: [{ id: "installed-1" }, { id: "installed-2" }] }), {
              status: 200,
              headers: { "content-type": "application/json" },
            }),
          );
        }),
      ),
    );
    const outcomes = yield* ResendBatchEmail.use((batch) =>
      batch.send([message, message], { idempotencyKey: "installed/batch-1" }),
    ).pipe(
      Effect.provide(resendBatchEmailLayer({ apiKey: Redacted.make("fictional-key") }).pipe(Layer.provide(transport))),
    );
    assert.equal(outcomes.length, 2);
    assert(outcomes.every(Result.isSuccess));
    assert.equal(yield* Ref.get(requests), 1);
  }),
);


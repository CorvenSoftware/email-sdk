import EffectLibrary = require("effect");
import React = require("react");
import EmailSdk = require("@corvencore/email-sdk");
import ReactEmail = require("@corvencore/email-sdk/react");
import Testing = require("@corvencore/email-sdk/testing");
import ReactScenarios = require("./react-scenarios.js");

const { Effect } = EffectLibrary;
const proveCommonjsReact = (body: ReactEmail.RenderedReactEmail): void => {
  const rendered: EffectLibrary.Effect.Effect<ReactEmail.RenderedReactEmail, ReactEmail.EmailRenderError> = ReactEmail.renderReactEmail(React.createElement("p", null, "Fictional"));
  const ordinary: EmailSdk.EmailBody = body;
  const componentCall = (components: ReactEmail.ReactEmailComponents): void => {
    // @ts-expect-error -- Actions require a destination in CommonJS too.
    void React.createElement(components.EmailAction, { children: "Missing destination" });
    void ReactEmail.themedReactEmailComponents();
    void ReactEmail.themedReactEmailComponents(ReactEmail.reactEmailTheme("dark", { radius: 0 }));
    // @ts-expect-error -- CommonJS preset names do not select an ambient color scheme.
    void ReactEmail.themedReactEmailComponents("system");
    // @ts-expect-error -- CommonJS partial overrides retain numeric CSS pixels.
    void ReactEmail.reactEmailTheme("light", { radius: "12px" });
    // @ts-expect-error -- Component families are readonly.
    components.EmailAction = () => React.createElement("p");
  };
  void componentCall;
  // @ts-expect-error -- CommonJS consumers retain owned readonly output.
  body.text = "changed";
  // @ts-expect-error -- Strings are not host React elements.
  void ReactEmail.renderReactEmail("private model template");
  void rendered;
  void ordinary;
};
void proveCommonjsReact;

void Effect.runPromise(ReactScenarios.verifyInstalledReactRendering({ EffectLibrary, React, EmailSdk, ReactEmail, Testing }));
